generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  ledger       Ledger?
  sessions     Session[]
}

// An aggregate gives budget + approval + audit atomicity in one optimistic update.
// Each aggregate belongs to exactly one user. Money inside data is integer cents.
model Ledger {
  userId  String @id
  version Int    @default(0)
  data    Json
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
