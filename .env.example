# Leave DATABASE_URL unset for an explicitly ephemeral in-memory demo.
DEMO_MODE=true
APP_ORIGIN=http://127.0.0.1:3000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# DATABASE_URL=postgresql://finpilot:change-me@localhost:5432/finpilot
# Required for npm run seed in PostgreSQL mode (12+ characters)
DEMO_PASSWORD=
# Optional: an OpenAI Responses API model available to your account
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional server-only deterministic analytics service
ANALYTICS_URL=http://127.0.0.1:8000
ANALYTICS_SERVICE_TOKEN=
